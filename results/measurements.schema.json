{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topic 7 measurement row",
  "type": "object",
  "required": ["run_id"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^run-[0-9]{2}$"},
    "line_coverage": {"type": ["number", "string"], "minimum": 0, "maximum": 100},
    "branch_coverage": {"type": ["number", "string"], "minimum": 0, "maximum": 100},
    "acceptance_passed": {"type": ["integer", "string"], "minimum": 0},
    "acceptance_total": {"type": ["integer", "string"], "minimum": 0},
    "properties_failed": {"type": ["integer", "string"], "minimum": 0},
    "raw_score_ai": {"type": ["number", "string"], "minimum": 0, "maximum": 100},
    "adjusted_score_ai": {"type": ["number", "string"], "minimum": 0, "maximum": 100},
    "raw_score_full": {"type": ["number", "string"], "minimum": 0, "maximum": 100},
    "adjusted_score_full": {"type": ["number", "string"], "minimum": 0, "maximum": 100}
  },
  "additionalProperties": true
}
